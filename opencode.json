{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio remoto",
      "options": {
        "baseURL": "http://192.168.0.16:1234/v1"
      },
      "models": {
        "qwen-local": {
          "name": "Qwen3.6 35B A3B Local",
          "limit": {
            "context": 65536,
            "output": 2048
          }
        }
      }
    }
  },
  "model": "lmstudio/qwen-local",
  "small_model": "lmstudio/qwen-local",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4000
  }
}
